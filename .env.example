# Local development only. Copy to .env without overwriting existing settings.
# These PostgreSQL credentials are for the loopback-only development database.
DATABASE_URL=postgresql+psycopg://polymath:polymath@127.0.0.1:5432/polymath

# Supply real credentials through secure runtime settings, never Git or chat.
# Paid research stays disabled until Meta access, pricing and account limits are verified and the owner permits paid calls.
# MODEL_API_KEY=
# META_MODEL=          # Set only after verifying the available Meta model ID.

# Publisher access and exact-document approval. All are disabled by default.
# Set the bootstrap credential securely on the server; never expose it in Git/chat.
# These settings authorize local preview/approval only, not any Zenodo request.
# OPERATOR_BOOTSTRAP_TOKEN=
# OPERATOR_ACTOR_ID=publisher
# OPERATOR_DISPLAY_NAME=Publisher
# PUBLICATION_APPROVAL_ENABLED=false
# PUBLICATION_PUBLISHER_ID=
# PUBLICATION_PUBLISHER_NAME=
# PUBLICATION_DESTINATIONS=["sandbox"]
