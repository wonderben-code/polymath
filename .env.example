# Local development only. Copy to .env without overwriting existing settings.
# These PostgreSQL credentials are for the loopback-only development database.
DATABASE_URL=postgresql+psycopg://polymath:polymath@127.0.0.1:5432/polymath

# Supply real credentials through secure runtime settings, never Git or chat.
# Paid research stays disabled until Meta access, pricing and account limits are verified and the owner permits paid calls.
# MODEL_API_KEY=
# META_MODEL=          # Set only after verifying the available Meta model ID.

# Publisher access and exact-document approval. All are disabled by default.
# Set the bootstrap credential securely on the server; never expose it in Git/chat.
# These settings authorize local preview/approval only, not any Zenodo request.
# OPERATOR_BOOTSTRAP_TOKEN=
# OPERATOR_ACTOR_ID=publisher
# OPERATOR_DISPLAY_NAME=Publisher
# PUBLICATION_APPROVAL_ENABLED=false
# PUBLICATION_PUBLISHER_ID=
# PUBLICATION_PUBLISHER_NAME=
# PUBLICATION_DESTINATIONS=["sandbox"]

# Separate live-publication gate. Leave off during setup and fixture development.
# Verify the native sandbox workflow before enabling any production destination.
# Each job still needs an exact human approval and an explicit Publish action.
# PUBLICATION_EXECUTION_ENABLED=false
# ZENODO_SANDBOX_TOKEN=
# ZENODO_PRODUCTION_TOKEN=

# Scheduled free literature collection is separate from model execution.
# LITERATURE_INGESTION_ENABLED=false

# Opt-in public finding snapshots are separate from research and DOI publication.
# Enabling this feature exposes only findings explicitly shared by their owner.
# PUBLIC_SHARING_ENABLED=false

# Operator-only disabled Meta readiness proposals and budget inspection/disable.
# These never authorize model execution or verify native access/billing.
# Explicitly allow the configured OPERATOR_ACTOR_ID; ordinary publisher login
# alone grants no budget role. The local application ceiling is at most $150.
# BUDGET_READINESS_ENABLED=false
# BUDGET_ADMIN_ACTOR_IDS=[]
# BUDGET_MAX_HARD_CAP_MICRODOLLARS=150000000

# Separately enabled one-call Meta protocol verification, never general research.
# Leave false until the owner authorizes paid work and native billing facts are
# established. A current exact operator approval is still required for each call.
# Native account is server-selected; credential rotation retains the same ledger.
# PAID_META_PROBE_ENABLED=false
# NATIVE_BUDGET_ACCOUNT_ID=

# Full native research is separately disabled. An exact current research
# activation is also required; a protocol probe never grants this permission.
# PAID_META_RESEARCH_ENABLED=false

# Visitor research needs separate reviewed funding on the same ledger.
# These flags alone grant nothing and remain off by default.
# PUBLIC_META_RESEARCH_ENABLED=false
# PUBLIC_RESOURCE_LIMITS_ENABLED=false
