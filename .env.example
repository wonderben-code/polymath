# Copy to .env and fill in. Never commit .env.

# Meta Model API (from dev.meta.ai) — server-side only
MODEL_API_KEY=
POLYMATH_API_BASE=https://api.meta.ai/v1
POLYMATH_MODEL=muse-spark-1.1
POLYMATH_FAST_MODEL=

# Storage
POLYMATH_DB=polymath.db

# Sources
POLYMATH_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Publishing (Zenodo) — sandbox until the demo is final
ZENODO_TOKEN=
ZENODO_SANDBOX=true

# Formalisation (optional path to `lake`)
LEAN_BIN=

# Run limits (protect the $150 credit budget)
POLYMATH_MAX_FIELDS=6
POLYMATH_PAPERS_PER_FIELD=8
POLYMATH_MAX_CANDIDATES=12
POLYMATH_MAX_BRIDGES=5
