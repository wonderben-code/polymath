# Copy to deploy/production.env on the server only (it is git-ignored) and
# restrict it: chmod 600 deploy/production.env. Never commit or paste it in chat.

# Required for every start.
POLYMATH_DOMAIN=polymath.example.org
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Operator login for the budget desk and publisher review. Also required by the
# public visitor rate/queue limits below.
OPERATOR_BOOTSTRAP_TOKEN=

# Optional: pull a CI-built image instead of building on the server, pinned
# by digest, e.g. ghcr.io/wonderben-code/polymath@sha256:<digest>. Log in once
# with `docker login ghcr.io` using a token that can read packages.
# POLYMATH_IMAGE=

# Optional free OpenAlex key, sent only as a Bearer header by the workers.
# OPENALEX_API_KEY=

# Read-only public site first: every execution gate below stays false until it
# is separately reviewed. See docs/KEY_DAY.md and docs/DEPLOYMENT.md.
PUBLIC_SHARING_ENABLED=false
PUBLIC_RESOURCE_LIMITS_ENABLED=true
LITERATURE_INGESTION_ENABLED=false

# OPERATOR_ACTOR_ID=owner
# OPERATOR_DISPLAY_NAME=Owner
# BUDGET_READINESS_ENABLED=false
# BUDGET_ADMIN_ACTOR_IDS=["owner"]
# BUDGET_MAX_HARD_CAP_MICRODOLLARS=150000000

# Meta. A key alone authorizes nothing; paid gates need the owner's go-ahead.
# MODEL_API_KEY=
# META_MODEL=muse-spark-1.3
# NATIVE_BUDGET_ACCOUNT_ID=
PAID_META_PROBE_ENABLED=false
PAID_META_RESEARCH_ENABLED=false
PUBLIC_META_RESEARCH_ENABLED=false
# Longest single public funding window the owner may approve, in seconds
# (default one day; at most 14 days, e.g. 1209600 to cover a judging period).
PUBLIC_MAX_DELEGATION_SECONDS=86400

# Connect Zenodo for every visitor (docs/CONNECT_ZENODO.md). Visitors publish to
# their own Zenodo accounts; nobody can publish to yours. Register a free OAuth
# app on each site with the redirect URI https://<your-domain>/zenodo/callback.
VISITOR_ZENODO_ENABLED=false
# 32 random bytes in base64: openssl rand -base64 32
ZENODO_CONNECTION_KEY=
PUBLIC_SITE_ORIGIN=https://polymath.example.org
ZENODO_SANDBOX_CLIENT_ID=
ZENODO_SANDBOX_CLIENT_SECRET=
ZENODO_PRODUCTION_CLIENT_ID=
ZENODO_PRODUCTION_CLIENT_SECRET=

# Zenodo publication: sandbox first, production only with exact approval.
PUBLICATION_APPROVAL_ENABLED=false
PUBLICATION_EXECUTION_ENABLED=false
# PUBLICATION_DESTINATIONS=["sandbox"]
# PUBLICATION_PUBLISHER_ID=
# PUBLICATION_PUBLISHER_NAME=
# ZENODO_SANDBOX_TOKEN=
# ZENODO_PRODUCTION_TOKEN=
